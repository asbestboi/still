#!/usr/bin/env xdg-open
[Desktop Entry]
Type=Application
Name=Still
GenericName=Photo Editor
Comment=A quiet photo editor: tone, texture and restrained glitch
Exec=still %f
Icon=still
Terminal=false
Categories=Graphics;Photography;RasterGraphics;
MimeType=image/jpeg;image/png;image/tiff;image/webp;image/x-panasonic-rw2;image/x-canon-cr2;image/x-nikon-nef;image/x-sony-arw;image/x-adobe-dng;image/x-fuji-raf;
StartupWMClass=still
